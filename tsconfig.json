{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["DOM", "ES2020"],
    "module": "ESNext",
    "moduleResolution": "Node",
    "strict": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["vite/client", "@figma/plugin-typings"],
    "skipLibCheck": true
  },
  "include": ["src"]
} 